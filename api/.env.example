DATABASE_URL=postgresql+psycopg://docbot:docbot@localhost:5433/docbot
REDIS_URL=redis://localhost:6380/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Embeddings: "voyage" (needs VOYAGE_API_KEY) or "hash" (offline dev fallback, low quality)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
