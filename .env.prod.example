# Copy to .env (next to docker-compose.prod.yml) on the server. Compose reads it automatically.
# The app's own settings (LLM keys, JWT_SECRET) go in api/.env.

# Your hostname, e.g. docbot.duckdns.org (its DNS must point at this server).
# The dashboard is served at https://APP_DOMAIN and the API at https://APP_DOMAIN/api.
APP_DOMAIN=

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# (hex keeps it safe inside the database URL)
POSTGRES_PASSWORD=

# Same command, a different value.
REDIS_PASSWORD=
